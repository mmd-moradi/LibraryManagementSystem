<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.library.controllers.BorrowingsViewController">
    <TableView fx:id="borrowedBooksTable" layoutX="14.0" layoutY="14.0" prefHeight="400.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="borrowIdCol" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="bookIdCol" prefWidth="75.0" text="Book ID" />
            <TableColumn fx:id="userIdCol" prefWidth="75.0" text="User ID" />
            <TableColumn fx:id="borrowDateCol" prefWidth="100.0" text="Borrow Date" />
            <TableColumn fx:id="returnDateCol" prefWidth="100.0" text="Return Date" />
            <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>
</AnchorPane>