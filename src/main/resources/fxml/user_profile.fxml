<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.UserProfileController"
      spacing="15.0" alignment="CENTER" 
      prefWidth="500.0" prefHeight="400.0"
      stylesheets="@../css/styles.css">
      
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    
    <Text text="Perfil do Usuário" styleClass="welcome-text"/>
    
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        
        <!-- Common User Details -->
        <Label text="Nome:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="nameLabel" text="[Nome do Usuário]" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="ID do Usuário:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="userIdLabel" text="[ID do Usuário]" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Tipo de Usuário:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="userTypeLabel" text="[Tipo do Usuário]" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Email:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="emailLabel" text="[Email]" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Telefone:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="phoneLabel" text="[Telefone]" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Endereço:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="addressLabel" text="[Endereço]" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    
    <Button fx:id="closeButton" text="Fechar" onAction="#handleClose" prefWidth="100.0" styleClass="primary-button"/>
</VBox>