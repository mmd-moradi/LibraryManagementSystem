<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.BorrowingsViewController">
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBack" text="← Voltar" />
                  <Label text="Empréstimos Atuais" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Separator />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="25.0" prefWidth="270.0" promptText="Buscar empréstimos..." />
                  <ComboBox fx:id="searchTypeComboBox" prefWidth="150.0" promptText="Critério" />
                  <Button mnemonicParsing="false" onAction="#handleSearch" text="Buscar" />
                  <Button mnemonicParsing="false" onAction="#handleClear" text="Limpar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="borrowingsTable" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="borrowingIdColumn" prefWidth="100.0" text="ID Empréstimo" />
          <TableColumn fx:id="bookIdColumn" prefWidth="100.0" text="ID Livro" />
          <TableColumn fx:id="bookTitleColumn" prefWidth="150.0" text="Título do Livro" />
          <TableColumn fx:id="userIdColumn" prefWidth="100.0" text="ID Usuário" />
          <TableColumn fx:id="userNameColumn" prefWidth="150.0" text="Nome do Usuário" />
          <TableColumn fx:id="borrowDateColumn" prefWidth="100.0" text="Data Empréstimo" />
          <TableColumn fx:id="dueDateColumn" prefWidth="100.0" text="Data Devolução" />
          <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleIssueBook" text="Emprestar Livro" />
            <Button mnemonicParsing="false" onAction="#handleReturnBook" text="Devolver Livro" />
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <Button mnemonicParsing="false" onAction="#handleRefresh" text="Atualizar" />
         </children>
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>