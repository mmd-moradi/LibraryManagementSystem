<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.library.controller.LoginController"
          prefHeight="400.0" prefWidth="600.0"
          style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20.0" maxWidth="350.0">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>
        
        <Text text="Sistema de Gerenciamento de Biblioteca" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Text text="Login" style="-fx-font-size: 16px;"/>
        
        <VBox spacing="10.0">
            <TextField fx:id="usernameField" promptText="Nome de usuário" />
            <PasswordField fx:id="passwordField" promptText="Senha" />
        </VBox>
        
        <Label fx:id="errorLabel" text="Nome de usuário ou senha inválidos" textFill="RED" visible="false" />
        
        <HBox spacing="10.0" alignment="CENTER">
            <Button fx:id="loginButton" text="Entrar" onAction="#handleLogin" prefWidth="100.0" />
        </HBox>
        
    </VBox>
</StackPane>